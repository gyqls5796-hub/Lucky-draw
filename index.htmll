<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>건강 타로 카드 뽑기</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;700&display=swap');

        body {
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            height: 100vh;
            background-color: #1a1a2e;
            font-family: 'Noto Sans KR', sans-serif;
            overflow: hidden;
            color: white;
        }

        .header-text {
            margin-bottom: 40px;
            font-size: 24px;
            font-weight: 700;
            text-align: center;
            z-index: 10;
            transition: opacity 0.3s ease;
        }

        .card-container {
            display: flex;
            gap: 20px;
            position: relative;
        }

        /* 카드 기본 스타일 */
        .card {
            width: 160px;
            height: 260px;
            perspective: 1000px;
            cursor: pointer;
            transition: all 0.5s cubic-bezier(0.25, 0.8, 0.25, 1);
            position: relative;
        }

        /* 카드가 선택되었을 때 (확장 및 강조) */
        .card.active {
            transform: scale(1.6) translateY(-10px);
            z-index: 100;
            box-shadow: 0 20px 40px rgba(0,0,0,0.5);
        }

        /* 선택되지 않은 나머지 카드들 (흐리게 처리) */
        .card-container.has-active .card:not(.active) {
            opacity: 0.3;
            transform: scale(0.9);
            pointer-events: none;
        }

        .card-inner {
            width: 100%;
            height: 100%;
            position: relative;
            transition: transform 0.8s;
            transform-style: preserve-3d;
        }

        /* 카드가 뒤집혔을 때 */
        .card.active .card-inner {
            transform: rotateY(180deg);
        }

        .card-front, .card-back {
            width: 100%;
            height: 100%;
            position: absolute;
            backface-visibility: hidden;
            border-radius: 15px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            box-shadow: 0 4px 15px rgba(0,0,0,0.3);
            text-align: center;
            padding: 15px;
            box-sizing: border-box;
        }

        /* 카드 뒷면 (처음 보여지는 타로 카드 문양 부분) */
        .card-front {
            background: linear-gradient(135deg, #2c3e50, #4ca1af);
            border: 2px solid #f39c12;
            color: #f39c12;
            font-size: 40px;
        }

        .card-front::after {
            content: "✨"; /* 타로카드 뒷면 장식 */
        }

        /* 카드 앞면 (결과 내용) */
        .card-back {
            background: #ffffff;
            color: #333;
            transform: rotateY(180deg);
            border: 2px solid #ddd;
        }

        .card-icon {
            font-size: 60px;
            margin-bottom: 15px;
        }

        .card-title {
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 5px;
            color: #2c3e50;
        }

        .card-desc {
            font-size: 12px;
            color: #666;
            word-break: keep-all;
        }

        /* 모바일 화면 대응 */
        @media (max-width: 600px) {
            .card-container {
                gap: 10px;
            }
            .card {
                width: 100px;
                height: 160px;
            }
            .card.active {
                transform: scale(2) translateY(-10px);
            }
            .card-icon {
                font-size: 40px;
            }
            .card-title {
                font-size: 14px;
            }
            .card-desc {
                font-size: 9px;
            }
        }
    </style>
</head>
<body>

    <div class="header-text" id="headerText">
        당신의 건강 타로를 1장 뽑아보세요
    </div>

    <div class="card-container" id="cardContainer">
        <!-- 카드 1 -->
        <div class="card" onclick="selectCard(this)">
            <div class="card-inner">
                <div class="card-front"></div>
                <div class="card-back">
                    <div class="card-icon">💉</div>
                    <div class="card-title">주사기</div>
                    <div class="card-desc">예방접종을 통해 질병을 미리 예방하세요.</div>
                </div>
            </div>
        </div>

        <!-- 카드 2 -->
        <div class="card" onclick="selectCard(this)">
            <div class="card-inner">
                <div class="card-front"></div>
                <div class="card-back">
                    <div class="card-icon">😷</div>
                    <div class="card-title">마스크</div>
                    <div class="card-desc">기침예절(예정)을 지켜 모두의 건강을 보호하세요.</div>
                </div>
            </div>
        </div>

        <!-- 카드 3 -->
        <div class="card" onclick="selectCard(this)">
            <div class="card-inner">
                <div class="card-front"></div>
                <div class="card-back">
                    <div class="card-icon">🧼</div>
                    <div class="card-title">손과 물</div>
                    <div class="card-desc">흐르는 물에 비누로 30초 이상 손씻기!</div>
                </div>
            </div>
        </div>
    </div>

    <script>
        function selectCard(selectedCard) {
            const container = document.getElementById('cardContainer');
            const header = document.getElementById('headerText');
            
            // 이미 카드가 선택된 상태라면 되돌리기 (초기화)
            if (selectedCard.classList.contains('active')) {
                selectedCard.classList.remove('active');
                container.classList.remove('has-active');
                header.style.opacity = '1';
                header.innerText = "당신의 건강 타로를 1장 뽑아보세요";
                return;
            }

            // 다른 카드가 이미 선택되어 있다면 변경 불가능하게 막기
            // (만약 다른 카드를 누를 수 있게 하려면 이 부분을 수정하면 됩니다)
            if (container.classList.contains('has-active')) {
                return; 
            }

            // 카드 선택 및 애니메이션 실행
            selectedCard.classList.add('active');
            container.classList.add('has-active');
            
            // 상단 텍스트 변경
            header.style.opacity = '0';
            setTimeout(() => {
                header.innerText = "결과가 나왔습니다!";
                header.style.opacity = '1';
            }, 300);
        }
    </script>

</body>
</html>
